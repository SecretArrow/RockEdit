<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/pref_appearance">
        <ListPreference
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:key="theme"
            android:title="@string/pref_theme_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_editor">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="line_numbers"
            android:title="@string/pref_line_numbers" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="word_wrap"
            android:title="@string/pref_word_wrap" />

        <ListPreference
            android:defaultValue="auto"
            android:entries="@array/line_break_entries"
            android:entryValues="@array/line_break_values"
            android:key="line_break"
            android:title="@string/pref_line_break"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="full_screen"
            android:title="@string/pref_full_screen" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="syntax_highlight"
            android:title="@string/pref_syntax" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="bracket_pair_colors"
            android:summary="@string/pref_bracket_colors_summary"
            android:title="@string/pref_bracket_colors" />

        <ListPreference
            android:defaultValue="14"
            android:entries="@array/font_size_entries"
            android:entryValues="@array/font_size_values"
            android:key="font_size"
            android:title="@string/pref_font_size"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="monospace"
            android:entries="@array/font_family_entries"
            android:entryValues="@array/font_family_values"
            android:key="font_family"
            android:title="@string/pref_font_family"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="spaces"
            android:entries="@array/indent_style_entries"
            android:entryValues="@array/indent_style_values"
            android:key="indent_style"
            android:title="@string/pref_indent_style"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="4"
            android:entries="@array/indent_size_entries"
            android:entryValues="@array/indent_size_values"
            android:key="indent_size"
            android:summary="@string/pref_indent_size_summary"
            android:title="@string/pref_indent_size"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="auto_save"
            android:title="@string/pref_auto_save" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_files_tabs">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="remember_tabs"
            android:title="@string/pref_remember_tabs" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="sort_folders_first"
            android:title="@string/pref_sort_folders" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="show_hidden_files"
            android:title="@string/pref_show_hidden" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_grammars">
        <Preference
            android:key="grammar_import"
            android:summary="@string/grammar_import_summary"
            android:title="@string/grammar_import" />

        <Preference
            android:key="grammar_manage"
            android:summary="@string/grammar_manage_summary"
            android:title="@string/grammar_manage" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_backup_restore">
        <Preference
            android:key="backup_data"
            android:title="@string/backup_data" />

        <Preference
            android:key="restore_data"
            android:title="@string/restore_data" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_advanced">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="format_on_save"
            android:summary="@string/pref_format_on_save_summary"
            android:title="@string/pref_format_on_save" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="online_execution"
            android:summary="@string/pref_online_exec_summary"
            android:title="@string/pref_online_exec" />
    </PreferenceCategory>
</PreferenceScreen>
