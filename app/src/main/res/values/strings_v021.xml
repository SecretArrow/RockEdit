<?xml version="1.0" encoding="utf-8"?>
<!-- v0.21.0: folder-browser file management (create/rename/delete). -->
<resources>
    <!-- Actions shown for a long-pressed entry. -->
    <string name="ops_open">Open</string>
    <string name="ops_rename">Rename</string>
    <string name="ops_delete">Delete</string>

    <!-- Toolbar / dialog actions. -->
    <string name="new_folder">New folder</string>
    <string name="create">Create</string>

    <!-- Name input hints. -->
    <string name="name_hint_file">File name (e.g. notes.txt)</string>
    <string name="name_hint_folder">Folder name</string>
    <string name="name_hint_rename">New name</string>

    <!-- Delete confirmation. %1$s is the entry name; the dialog explains that
         SAF deletion is permanent (no trash can). -->
    <string name="delete_confirm_title">Delete?</string>
    <string name="delete_confirm_msg">\"%1$s\" will be deleted permanently. This cannot be undone.</string>

    <!-- Success feedback. -->
    <string name="msg_file_created">File created</string>
    <string name="msg_folder_created">Folder created</string>
    <string name="msg_renamed">Renamed</string>
    <string name="msg_deleted">Deleted</string>

    <!-- Failure feedback: one message per validation branch plus a generic
         failure for provider-side errors (revoked grant, collision on
         case-insensitive backends, I/O). -->
    <string name="err_name_empty">Name cannot be empty</string>
    <string name="err_name_chars">Name contains characters not allowed: / \\ : * ? \" &lt; &gt; |</string>
    <string name="err_name_dots">\".\" and \"..\" are reserved names</string>
    <string name="err_name_long">Name is too long (max 255 bytes)</string>
    <string name="err_name_exists">An entry with this name already exists</string>
    <string name="err_op_failed">Operation failed — the folder may be read-only or its access was revoked</string>
</resources>
